tg-project-archived-warning
.wrapper(ng-init="vm.loadInitialData()")
    tg-project-menu
    section.main.epics(role="main")
        header.header-with-actions
            h1(
                tg-main-title
                project-name="vm.project.get('name')"
                i18n-section-name="{{vm.sectionName}}"
            )
            .action-buttons(ng-if="vm.epics.size && vm.canCreateEpics()")
                button.btn-big.e2e-create-epic(
                    translate="EPICS.DASHBOARD.ADD"
                    title="{{ EPICS.DASHBOARD.ADD_TITLE | translate }}",
                    ng-click="vm.onCreateEpic()"
                )

        .taskboard-actions
            button.btn-filter.e2e-open-filter(
                ng-click="vm.openFilter = !vm.openFilter"
                title="{{vm.selectedFilters.length}} {{'COMMON.FILTERS.APPLIED_FILTERS_NUM' | translate}}"
                ng-class="{active: vm.openFilter}"
            )
                tg-svg(svg-icon="icon-filters")
                span.text(
                    ng-if="!vm.openFilter"
                    translate="BACKLOG.FILTERS.TITLE"
                )
                span.text(
                    ng-if="vm.openFilter"
                    translate="BACKLOG.FILTERS.HIDE_TITLE"
                )
                span.selected-filters(ng-if="vm.selectedFilters.length") {{vm.selectedFilters.length}}

            tg-input-search(
                q="vm.filterQ"
                change="vm.changeQ(q)"
            )

        .epics-manager(ng-class="{expanded: !vm.openFilter}")
            sidebar.filters-bar(
                ng-if="vm.openFilter"
            )
                tg-filter(
                    q="vm.filterQ"
                    filters="vm.filters"
                    custom-filters="vm.customFilters"
                    selected-filters="vm.selectedFilters"
                    on-save-custom-filter="vm.saveCustomFilter(name)"
                    on-add-filter="vm.addFilter(filter)"
                    on-select-custom-filter="vm.selectCustomFilter(filter)"
                    on-remove-custom-filter="vm.removeCustomFilter(filter)"
                    on-remove-filter="vm.removeFilter(filter)"
                    on-change-q="vm.changeQ(q)"
                )
                button.btn-small.e2e-clear-filters(
                    type="button"
                    translate="DISCOVER.FILTERS.CLEAR"
                    ng-click="vm.clearFilters()"
                    ng-if="vm.selectedFilters.length || vm.filterQ"
                )

            tg-epics-table(
                ng-if="vm.epics.size || vm.loadingEpics"
            )

            section.empty-epics.empty-large(ng-if="!vm.epics.size && !vm.loadingEpics")
                img(
                    src="#{v}/images/empty/empty_des.png"
                    ng-title="EPICS.EMPTY.HELP | translate"
                )
                h1.title(translate="EPICS.EMPTY.TITLE")
                p(translate="EPICS.EMPTY.EXPLANATION")
                a(
                    translate="EPICS.EMPTY.HELP"
                    href="https://tree.taiga.io/support/epics/what-is-an-epic/"
                    target="_blank"
                    ng-title="EPICS.EMPTY.HELP | translate"
                )
                button.create-epic.btn-big(
                    ng-if="vm.canCreateEpics()"
                    translate="EPICS.DASHBOARD.ADD"
                    title="{{ EPICS.DASHBOARD.ADD_TITLE | translate }}"
                    ng-click="vm.onCreateEpic()"
                )
